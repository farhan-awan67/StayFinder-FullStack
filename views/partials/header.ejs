<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>StayFinder</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
      integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/stylesheets/rating.css" />
    <link
      href="https://api.mapbox.com/mapbox-gl-js/v3.7.0/mapbox-gl.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/output.css" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <script src="../javascripts/map.js" defer></script>
  </head>
  <body>
    <header
      class="w-full px-2 py-1 sm:py-0 md:px-3 flex items-center justify-between gap-[15px] border-bottom border-2"
    >
    <div class="nav text-[17px] flex justify-center items-center gap-1">
      <a href="/listings"
        ><i class="fa-regular fa-compass text-[40px] text-black"></i
      ></a>
        <a class="text-black no-underline" href="/listings"
          >Explore</a
        >
      </div>
      <div
        class="search-head w-[70%] hidden sm:flex justify-center items-center"
      >
        <form  class="w-[70%] max-w-3xl flex justify-center items-center" action="/listings/search" method="get">
          <input
            type="text"
            placeholder="Search by location, title or price"
            name="query"
            class="rounded-md border-2 px-2 py-1 outline-blue-600"
          />
          <button
            class="ml-1.5 bg-red-700 text-white px-3 py-[5px] rounded-md"
            type="submit"
          >
            Search
          </button>
        </form>
      </div>
      <div
        id="nav"
        class="nav-links bg-white text-[17px] py-3 md:p-0 md:ml-auto absolute left-0 top-[-110%] right-0 h-screen flex flex-col items-center gap-2 transition-transform duration-300 ease-in-out md:static md:flex-row md:left-0 md:h-auto z-10"
      >
        <a class="text-black text-center no-underline leading-tight inline-block tracking-tighter w-full" href="/listings/newlist"
          >New Listing</a
        >
        <% if(!currUser){ %>
        <a href="/signup" class="text-black no-underline tracking-tighter"><b>Signup</b></a>
        <a class="md:ml-1 text-black no-underline" href="/login"
          ><b>Login</b></a
        >
        <% } %> <% if(currUser){ %>
        <a class="md:ml-1 text-black no-underline tracking-tighter" href="/logout"
          ><b>log out</b></a
        >
        <% } %>
      </div>
      <i
        id="menu"
        class="fa-solid fa-bars fa-fw ml-auto block md:hidden text-xl cursor-pointer"
      ></i>
      <i id="close" class="fa-solid fa-xmark fa-fw hidden text-lg cursor-pointer"></i>
    </header>
    <% if(success && success.length){ %>
    <div
      class="alert alert-success alert-dismissible fade show w-[90%] sm:w-[300px] md:w-[310px] m-auto mt-1 z-10"
      role="alert"
    >
      <symbol id="check-circle-fill" viewBox="0 0 16 16">
        <path
          d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"
        />
      </symbol>
      <%= success %>
      <button
        type="button"
        class="btn-close"
        data-bs-dismiss="alert"
        aria-label="Close"
      ></button>
    </div>
    <% } %> <% if(error && error.length){ %>
    <div
      class="alert alert-danger alert-dismissible fade show w-[90%] sm:w-[250px] md:w-[310px] m-auto mt-1 z-10"
      role="alert"
    >
      <symbol id="exclamation-triangle-fill" viewBox="0 0 16 16">
        <path
          d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"
        />
      </symbol>
      <%= error %>
      <button
        type="button"
        class="btn-close"
        data-bs-dismiss="alert"
        aria-label="Close"
      ></button>
    </div>
    <% } %>
  </body>
</html>
