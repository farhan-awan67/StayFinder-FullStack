<%- include("partials/header"); -%>
<main class="w-full h-screen flex justify-center items-start">
  <form
    action="/login"
    method="post"
    class="w-full max-w-[300px] rounded-md px-2 py-2 needs-validation"
    novalidate
  >
    <h1 class="font-bold text-center text-[20px]">Login</h1>
    <div class="w-full mb-[8px]">
      <label class="text-[17px]" for="username">Username</label>
      <input
        id="username"
        type="text"
        class="w-full border-2 border-gray px-2 py-[2px] rounded-md form-control"
        name="username"
        required
        autocomplete="off"
      />
    </div>
    <div class="w-full mb-[8px]">
      <label class="text-[17px]" for="password">Password</label>
      <input id="password type="password" class="w-full border-2 border-gray
      px-2 py-[2px] rounded-md form-control" name="password" required
      autocomplete="off" />
    </div>
    <div class="flex justify-center items-center">
      <button class="px-2 py-2 rounded-md text-white bg-blue-700">Login</button>
    </div>
  </form>
</main>

<%- include("partials/footer"); -%>
