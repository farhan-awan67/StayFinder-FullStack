<%- include("partials/header"); -%>
<div class="main-edit w-full flex flex-col justify-center items-center">
  <h1 class="text-center font-bold text-xl mt-2">Update Listing</h1>
  <form
    class="flex items-center flex-col w-full max-w-[500px] my-4"
    action="/listings/<%= findList._id%>/update?_method=PUT"
    method="post"
    enctype="multipart/form-data"
  >
    <div class="w-full mb-[8px]">
      <label class="text-[16px]" for="title">Title</label>
      <input
        class="w-full border-2 border-black px-2 py-[5px] rounded-md"
        type="text"
        value="<%= findList.title %>"
        name="listing[title]"
        id="title"
      />
    </div>
    <div class="w-full mb-[8px]">
      <label class="text-[16px]" for="description">Description</label>
      <textarea
        class="w-full border-2 border-black px-2 py-[5px] rounded-md"
        type="text"
        name="listing[description]"
        id="description"
      >
 <%= findList.description %></textarea
      >
    </div>
    <div class="w-full mb-[8px]">
      <label class="text-[16px]" for="image">Original Image</label>
      <img class="w-[40%] h-[50%]" src="<%= originalImageUrl %>" />
    </div>
    <div class="w-full mb-[8px]">
      <label class="text-[16px]" for="image">Upload New Image</label>
      <input
        class="w-full border-2 border-black px-2 py-[5px] rounded-md mb-2 form-control"
        type="file"
        name="listing[image]"
        id="image"
      />
    </div>
    <div class="w-full mb-[8px]">
      <label class="text-[16px]" for="location">Price</label>
      <input
        class="w-full border-2 border-black px-2 py-[5px] rounded-md"
        type="number"
        name="listing[price]"
        value="<%= findList.price %>"
        id="location"
      />
    </div>
    <div class="w-full mb-[8px]">
      <label class="text-[16px]" for="location">Location</label>
      <input
        class="w-full border-2 border-black px-2 py-[5px] rounded-md"
        type="text"
        value="<%= findList.location %>"
        name="listing[location]"
        id="location"
      />
    </div>
    <div class="w-full mb-[8px]">
      <label class="text-[16px]" for="country">Country</label>
      <input
        class="w-full border-2 border-black px-2 py-[5px] rounded-md"
        type="text"
        value="<%= findList.country %>"
        name="listing[country]"
        id="country"
      />
    </div>
    <button class="bg-yellow-500 py-2 px-4 rounded-md text-white">
      Update
    </button>
  </form>
</div>
<%- include("partials/footer"); -%>
