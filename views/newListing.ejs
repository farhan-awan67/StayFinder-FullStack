<%- include("partials/header"); -%>
<div class="main-newList flex flex-col justify-center items-center p-2">
  <h1 class="text-center font-bold text-xl mt-4">Create New Listing</h1>
  <form
    class="needs-validation flex items-center flex-col w-full max-w-[500px] mb-4"
    novalidate
    action="/listings"
    method="post"
    enctype="multipart/form-data"
  >
    <div class="w-full mb-[8px]">
      <label class="text-[16px]" for="title">Enter Title</label>
      <input
        class="w-full border-2 border-black px-2 py-[5px] rounded-md form-control"
        type="text"
        placeholder="add a catchy title"
        name="listing[title]"
        id="title"
        required
      />
    </div>
    <div class="w-full mb-[8px]">
      <label class="text-[16px]" for="description">Enter Description</label>
      <textarea
        class="w-full border-2 border-black px-2 py-[5px] rounded-md mb-2 form-control"
        type="text"
        name="listing[description]"
        placeholder="description"
        id="description"
        required
      ></textarea>
    </div>
    <div class="w-full mb-[8px]">
      <label class="text-[16px]" for="image">Upload Image</label>
      <input
        class="w-full border-2 border-black px-2 py-[5px] rounded-md mb-2 form-control"
        type="file"
        name="listing[image]"
        id="image"
      />
    </div>
    <div class="w-full mb-[8px]">
      <label class="text-[16px]" for="price">Enter Price</label>
      <input
        class="w-full border-2 border-black px-2 py-[5px] rounded-md mb-2 form-control"
        type="text"
        name="listing[price]"
        placeholder="enter price"
        id="price"
        required
      />
    </div>
    <div class="w-full mb-[8px]">
      <label class="text-[16px]" for="location">Enter Location</label>
      <input
        class="w-full border-2 border-black px-2 py-[5px] rounded-md mb-2 form-control"
        type="text"
        placeholder="location"
        name="listing[location]"
        id="location"
        required
      />
    </div>
    <div class="w-full mb-[8px]">
      <label class="text-[16px]" for="country">Enter Country</label>
      <input
        class="w-full border-2 border-black px-2 py-[5px] rounded-md mb-2 form-control"
        type="text"
        placeholder="country"
        name="listing[country]"
        id="country"
        required
      />
    </div>
    <button class="bg-blue-700 py-2 px-4 rounded-md text-white">Add</button>
  </form>
</div>
<%- include("partials/footer"); -%>
